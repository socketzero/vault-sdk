{
  "name": "@socket0/vault-sdk",
  "version": "0.2.2",
  "description": "The one implementation of the Socket0 vault: envelopes, key groups, buckets, the API key format and the binary bundle.",
  "homepage": "https://vault.socket0.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socketzero/vault-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/socketzero/vault-sdk/issues"
  },
  "keywords": [
    "socket0",
    "vault",
    "encryption",
    "x25519",
    "hkdf",
    "aes-gcm",
    "secrets"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run test:cov",
    "prepack": "npm run build",
    "bench": "npm run build && node bench/bundle-bench.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "bin": {
    "s0bundle": "./bin/s0bundle.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
